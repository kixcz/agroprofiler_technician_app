# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_API_RETRY_ATTEMPTS=3
EXPO_PUBLIC_API_RETRY_DELAY=1000

# App Configuration
EXPO_PUBLIC_APP_NAME=Agro Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=1

# Environment
EXPO_PUBLIC_ENVIRONMENT=development

# Logging
EXPO_PUBLIC_LOG_LEVEL=debug

# Feature Flags
EXPO_PUBLIC_FEATURE_AUTH=true
EXPO_PUBLIC_FEATURE_OFFLINE_MODE=true

# Analytics
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=

# Secure Store Keys (DO NOT include actual values in .env)
# These are managed through EAS secrets in production
