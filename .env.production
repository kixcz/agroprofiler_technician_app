# Production Environment Configuration
# Copy this file to .env.production and update with production values
# NEVER commit this file to version control

# API Configuration (Production)
EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_API_RETRY_ATTEMPTS=3
EXPO_PUBLIC_API_RETRY_DELAY=1000

# App Configuration
EXPO_PUBLIC_APP_NAME=Agro Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=1

# Platform Identifiers
EXPO_PUBLIC_IOS_BUNDLE_ID=com.agromobile.app
EXPO_PUBLIC_ANDROID_PACKAGE=com.agromobile.app

# Environment
EXPO_PUBLIC_ENVIRONMENT=production

# Logging
EXPO_PUBLIC_LOG_LEVEL=warn

# Feature Flags
EXPO_PUBLIC_FEATURE_AUTH=true
EXPO_PUBLIC_FEATURE_OFFLINE_MODE=true

# Analytics
EXPO_PUBLIC_ANALYTICS_ENABLED=true
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID

# EAS Updates (if using Expo Updates)
EXPO_PUBLIC_UPDATES_URL=https://updates.yourdomain.com/updates
