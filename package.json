{
  "name": "agro_new_ver_mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "build:dev": "expo run:android",
    "build:dev:clean": "expo run:android --no-build-cache",
    "build:preview": "eas build --platform all --profile preview",
    "build:production": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "clean": "rm -rf .expo node_modules"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
