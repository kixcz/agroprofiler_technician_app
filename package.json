    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "expo": "~55.0.11",
    "expo-camera": "~55.0.15",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.23",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-image-picker": "~55.0.18",
    "expo-linking": "~55.0.11",
    "expo-location": "~55.1.15",
    "expo-network": "~55.0.13",
